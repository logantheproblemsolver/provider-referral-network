# Copy to .env and adjust as needed. Do NOT commit your real .env.

# --- Postgres (consumed by docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=referral_network
POSTGRES_PORT=5432

# --- resource-api ---
# Example connection string; adapt to your ORM/driver.
DATABASE_URL=postgresql://app:app@localhost:5432/referral_network
JWT_SECRET=change-me-in-your-env
VERIFICATION_SVC_URL=http://localhost:9000

# --- verification-svc ---
VERIFICATION_SVC_PORT=9000
# Shared material so verification-svc can validate tokens from resource-api.
# (Use a shared secret, or swap to asymmetric keys / JWKS if you prefer.)
# The resource api jwks should be used witht he docker networking. So example http://resource-api:8000/.well-known/jwks.json
RESOURCE_API_JWKS_URL=url-for-wellknown-jwks
SERVICE_ACTIVE_KID=key-1
SERVICE_PRIVATE_KEY_1=base64-cert
SERVICE_PRIVATE_KEY_2=base64-cert


# --- OpenID Connect (only if you use a real/local IdP) ---
# OIDC_ISSUER=http://localhost:8080/realms/your-realm
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
OIDC_URL=well-known-configuration-url